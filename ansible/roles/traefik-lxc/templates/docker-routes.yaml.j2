http:
  routers:
    # --- Traefik dashboard (this host) ---
    traefik-dashboard:
      rule: "Host(`traefik.{{ cloudflare_dns_zone }}`)"
      service: api@internal
      entryPoints:
        - secureweb
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ cloudflare_dns_zone }}"
            sans:
              - "*.{{ cloudflare_dns_zone }}"
      middlewares:
        - security-headers@file
        - traefik-bouncer@file
        - ipAllowList@file

    # --- Infrastructure ---
    portainer:
      rule: "Host(`portainer.{{ cloudflare_dns_zone }}`)"
      service: portainer
      entryPoints:
        - secureweb
      tls: {}
      middlewares:
